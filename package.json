{
  "name": "mudio",
  "productName": "Mudio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "vite",
    "backend": "node backend/server.mjs",
    "build": "tsc -b && vite build",
    "package": "npm run build && electron-builder",
    "test": "vitest run"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/noto-sans-sc": "^5.2.5",
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "clsx": "^2.1.1",
    "electron": "^36.3.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.511.0",
    "music-metadata": "^11.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.mudio.app",
    "productName": "Mudio",
    "icon": "public/icon.png",
    "directories": { "output": "temp/package" },
    "files": ["dist/**"],
    "electronLanguages": ["zh-CN", "en-US"],
    "afterAllArtifactBuild": "build/collect-installer.cjs",
    "fileAssociations": [
      { "ext": ["mp4", "m4v", "webm", "mkv", "mov", "ogv"], "name": "Mudio.Video", "description": "Video", "role": "Viewer" }
    ],
    "win": { "target": ["nsis", "zip"], "artifactName": "${productName}-${version}-Portable.${ext}" },
    "nsis": { "artifactName": "${productName}-${version}-Setup.${ext}", "include": "build/installer.nsh", "oneClick": false, "allowToChangeInstallationDirectory": true, "differentialPackage": false },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
